# Copy to .env.local (never committed) and fill in as needed.
# The demo must run with none of this set: VITE_BACKEND defaults to 'mock',
# which is a full in-process implementation with no network calls.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_BACKEND=mock          # mock | supabase

# Edge function secrets only. Never prefix these with VITE_ — that would
# ship them to the browser bundle.
ANTHROPIC_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
